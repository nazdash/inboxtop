EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your-imap-app-password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
LLM_PROVIDER=openai
# Generated analysis: en (English, default) or ru (Russian)
ANALYSIS_LANGUAGE=en
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional separate local classifier; defaults to OLLAMA_MODEL
# OLLAMA_CLASSIFIER=qwen3.5:4b
# Optional; default is ~/.local/share/inboxtop-terminal
# INBOXTOP_DATA_DIR=

# These are initial defaults. Saved in-app Settings override provider/model/language choices.
